# Google Sheets CSV URL (optional, used for CSV import)
VITE_PROJECTS_CSV_URL=your_google_sheets_csv_url_here

# API URL (leave empty for production, functions will use relative paths)
VITE_API_URL=

# Database URL - Add this to Netlify Environment Variables
# DATABASE_URL=postgresql://user:password@host:port/database

# Cloudinary Configuration - Add this to Netlify Environment Variables
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
